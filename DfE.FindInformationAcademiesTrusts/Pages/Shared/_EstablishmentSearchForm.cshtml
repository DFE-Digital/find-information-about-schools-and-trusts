@using System.Linq
@model IEstablishmentSearchFormModel
@{
    var placeholderText = Html.Raw("e.g. st mary's primary school");
    var keywords = Html.Raw(Model.KeyWords);
    var autocompleteEndpoint = Url.Page(Model.AutocompletePagePath, pageHandler: "PopulateAutocomplete");
    var hasError = !ViewData.ModelState.IsValid;
    var errorMessage = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage;
}

<div data-testid="app-search-form">
    <div class="govuk-form-group @(hasError ? "govuk-form-group--error" : "")">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--l">
              @Model.Heading
            </label>
        </h1>
        <div id="school-hint" class="govuk-hint">
           @Model.Hint
        </div>
        
        @if (hasError)
        {
            <p id="@Model.PageSearchFormInputId-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> @errorMessage
            </p>
        }
        @* This is used by the no javascript users *@
        <div class="app-search__wrapper app-search__wrapper--standalone">
            <div id="@Model.PageSearchFormInputId-no-js-search-container">
                <input class="govuk-input app-search__input @(hasError ? "govuk-input--error" : "")" id="@Model.PageSearchFormInputId" type="search" asp-for="KeyWords" name="keywords" placeholder="@placeholderText">
            </div>
        </div>
    </div>
    <button class="govuk-button govuk-!-margin-top-3 govuk-!-margin-bottom-0" data-module="govuk-button" type="submit">
        Continue
    </button>
</div>
@* This template is used by a script to implement autocomplete *@
<template id="@Model.PageSearchFormInputId-js-autocomplete-template">
    <div>
        <div id="@Model.PageSearchFormInputId-autocomplete-container"></div>
        <input type="hidden" id="@Model.PageSearchFormInputId-selected-id" name="id"/>
        <input type="hidden" id="@Model.PageSearchFormInputId-selected-referencenumber" name="referenceNumber"/>
        <input type="hidden" id="@Model.PageSearchFormInputId-selected-searchResultType" name="searchResultType"/>
    </div>
</template>

<script asp-add-nonce type="application/javascript">
    
 const loadPageFormAutocomplete = async () => {
    await Autocomplete.loadTrustSearch("@Model.PageSearchFormInputId", "@keywords", "@placeholderText", "@autocompleteEndpoint", @hasError.ToString().ToLowerInvariant())
  }
  window.addEventListener("load", loadPageFormAutocomplete);

</script>
