@page "/watchlist/remove-trust"
@model DfE.FindInformationAcademiesTrusts.Pages.Watchlist.RemoveTrust

@{
    Layout = "_ContentLayout";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters">
        <span class="govuk-caption-l">Remove from watchlist</span>
        <h1 class="govuk-heading-l">Remove trust from watchlist</h1>
        <div id="hint" class="govuk-hint">
            <p class="govuk-hint govuk-!-margin-bottom-1">
                Confirm the details below to remove the trust from your watchlist.
            </p>
            <p class="govuk-hint">
                The trust can still be found within FAST.
            </p>
        </div>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Trust name
                </dt>
                <dd class="govuk-summary-list__value">
                    @Model.Name
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    TRN
                </dt>
                <dd class="govuk-summary-list__value">
                    @Model.Trn
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Region
                </dt>
                <dd class="govuk-summary-list__value">
                    @Model.Region
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Companies House number
                </dt>
                <dd class="govuk-summary-list__value">
                    @Model.CompaniesHouseNumber
                </dd>
            </div>
        </dl>
        <form method="post" novalidate>
            <div class="govuk-button-group govuk-!-margin-top-5">
                <input type="hidden" name="Id" value="@Model.Id"/>
                <button class="govuk-button govuk-button--warning" type="submit" name="action" data-module="govuk-button"
                        data-cy="remove-from-watchlist-button">
                    Remove from watchlist
                </button>
                <a class="govuk-link" asp-page="/WatchList/Trusts">Cancel and go back to watchlist</a>
            </div>
        </form>
    </div>
</div>
