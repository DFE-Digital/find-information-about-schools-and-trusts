@page
@model DfE.FindInformationAcademiesTrusts.Pages.WatchList.Index

@{
    Layout = "_WatchListLayout";
    ViewData["Title"] = "Watchlist";
    ViewData["ActiveWatchListTab"] = "Schools";
}


<div class="govuk-grid-row">
        <div class="govuk-grid-column-full app-table-container">
            <table class="govuk-table si-row-colours-table" data-module="moj-sortable-table">
                <caption class="govuk-table__caption govuk-!-margin-bottom-4">
                    Schools
                </caption>
                <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header govuk-!-width-one-quarter" aria-sort="none">
                        School Name
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        URN
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Trust
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Local Authority
                    </th>
                    <th scope="col" class="govuk-table__header">

                    </th>
                </tr>
                </thead>

                <tbody class="govuk-table__body">
                @foreach (var item in Model.Items)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            <a class="govuk-link" asp-page="/">@item.Name</a>
                        </td>
                        <td class="govuk-table__cell">
                            @item.Urn
                        </td>
                        <td class="govuk-table__cell">
                            @item.TrustName
                        </td>
                        <td class="govuk-table__cell">
                            @item.LocalAuthority
                        </td>
                        <td class="govuk-table__cell">
                            <a class="govuk-link" asp-page="/">Remove</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
</div>