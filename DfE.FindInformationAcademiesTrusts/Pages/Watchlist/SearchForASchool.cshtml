@page "/watchlist/search-for-a-school"
@model DfE.FindInformationAcademiesTrusts.Pages.Watchlist.SearchForASchool

@{
    Layout = "_ContentLayout";
    ViewData["Title"] = "Search for a school";
}

@if (Model.ShowError)
{
    <partial name="_ErrorSummary"/>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters">
        <span class="govuk-caption-l">Add to watchlist</span>
        <form class="govuk-form-group app-search govuk-!-margin-bottom-0" asp-page="Search" method="post" role="search" aria-label="sitewide">
            <partial name="_EstablishmentSearchForm" model="Model" />
        </form>
    </div>
</div>

