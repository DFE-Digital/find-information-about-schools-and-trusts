@using Dfe.FindInformationAcademiesTrusts.Models
@model DfE.FindInformationAcademiesTrusts.Pages.Watchlist.WatchlistSubNavigationModel

<nav class="moj-sub-navigation" aria-label="Sub navigation">
    <ul class="moj-sub-navigation__list">
        <li class="moj-sub-navigation__item">
            <a class="moj-sub-navigation__link" asp-page="@Links.Watchlist.TrustsWatchlist.Page" aria-current="@(Model.ActiveTab == "Trusts" ? "page" : null)">
                Trusts (@Model.TrustsCount)
            </a>
        </li>
        <li class="moj-sub-navigation__item">
            <a class="moj-sub-navigation__link" asp-page="@Links.Watchlist.SchoolsWatchlist.Page" aria-current="@(Model.ActiveTab == "Schools" ? "page" : null)">
                Schools (@Model.SchoolsCount)
            </a>
        </li>
    </ul>
</nav>
