@page
@model DfE.FindInformationAcademiesTrusts.Pages.WatchList.ConfirmSchool



@{
    Layout = "_ContentLayout";
    
    
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters">
        <span class="govuk-caption-l">Confirm School</span>
        <h1 class="govuk-heading-xl">Confirm School</h1>
        <div id="school-hint" class="govuk-hint">
            @Model.Id @Model.Name 
        </div>
        <form method="post">
            <input type="hidden" name="establishmentId" value="@Model.Id" />
            <button>Add school</button>
        </form>
    </div>
</div>
