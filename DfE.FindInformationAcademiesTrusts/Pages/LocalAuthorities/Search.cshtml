@page "/localauthorities/search"
@model DfE.FindInformationAcademiesTrusts.Pages.LocalAuthorities.SearchModel

@{
    ViewData["Title"] = "Local authorities";
}

<main id="main-content">
  <div class="app-banner app-banner--blue govuk-!-padding-top-3 govuk-!-padding-bottom-5">
    <div class="govuk-width-container">
      <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
              <partial name="_SearchBannerHeading" view-data='new ViewDataDictionary(ViewData) { { "Highlight", "local authorities" } }'/>
              <p class="govuk-body">Use this tool to find information on local authorities.</p>
              <hr class="govuk-section-break govuk-section-break--s">
              <form class="govuk-form-group app-search govuk-!-margin-bottom-0" asp-page="Search" method="post" role="search" aria-label="sitewide">
                  <partial name="_LocalAuthorityAutocomplete" model="Model"/>
              </form>
          </div>
      </div>
    </div>
  </div>
    <div class="dfe-width-container govuk-!-padding-top-6 govuk-!-padding-bottom-2">
      <h2 class="govuk-heading-l">
        Other tools and products (links open in a new tab)
      </h2>
        <div class="dfe-grid-container dfe-grid-container__fit">
        @foreach (var serviceLink in Model.ServiceLinks)
        {
            DisplayLinkInCard(serviceLink);
        }
      </div>
    </div>
</main>

@functions
{
  private void DisplayLinkInCard(DfE.FindInformationAcademiesTrusts.Data.ExternalServiceLink serviceLink)
  {
    <div class="dfe-card dfe-card__auto-width">
      <div class="dfe-card-container">
        <h3 class="govuk-heading-m">
          <a href="@serviceLink.Url" class="govuk-link govuk-link--no-visited-state dfe-card-link--header" rel="noopener" target="_blank" aria-label="@serviceLink.ServiceName (opens in a new tab)">@serviceLink.ServiceName</a>
        </h3>
        <p>@serviceLink.ServiceDescription</p>
      </div>
    </div>
  }
}