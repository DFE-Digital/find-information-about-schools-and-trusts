@page
@model DfE.FindInformationAcademiesTrusts.Pages.WatchList.RemoveTrust

@{
    Layout = "_ContentLayout";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters">
        <span class="govuk-caption-l">Remove Trust</span>
        <h1 class="govuk-heading-xl">Remove Trust</h1>
        <div id="trust-hint" class="govuk-hint">
            @Model.Id
        </div>
        <form method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <button>Remove Trust</button>
        </form>
    </div>
</div>
