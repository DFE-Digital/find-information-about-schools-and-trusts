@model System.Collections.Generic.IEnumerable<DfE.FindInformationAcademiesTrusts.Application.Watchlist.Models.EstablishmentWatchlistDto>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <table class="govuk-table si-row-colours-table" data-module="moj-sortable-table">
            <caption class="govuk-table__caption govuk-visually-hidden">
                My watched schools
            </caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header govuk-!-width-one-quarter" aria-sort="none">
                        School Name
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        URN
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Trust
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Local Authority
                    </th>
                </tr>
            </thead>

            <tbody class="govuk-table__body">
                @foreach (var item in Model)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            @item.Name
                        </td>
                        <td class="govuk-table__cell">
                            @item.Urn
                        </td>
                        <td class="govuk-table__cell">
                            @item.TrustName
                        </td>
                        <td class="govuk-table__cell">
                            @item.LocalAuthority
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
