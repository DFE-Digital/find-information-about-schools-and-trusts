@page "/watchlist/select-establishment-type"
@model DfE.FindInformationAcademiesTrusts.Pages.Watchlist.SelectEstablishmentType

@{
    Layout = "_ContentLayout";
    ViewData["Title"] = "Select Establishment Type";
}

@if (Model.ShowError)
{
    <partial name="_ErrorSummary"/>
}



<div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters">
        <span class="govuk-caption-l">Add to watchlist</span>
        <form method="post" novalidate>
            <govuk-radiobuttons-input name="@nameof(Model.OrganisationType)"
                                      radio-buttons="@Model.OrganisationTypeRadioButtons"
                                      error-message="@Model.ErrorMessage"
                                      asp-for="@Model.OrganisationType"
                                      heading="Select the type of establishment to add"/>
            

            <button class="govuk-button" type="submit">
                Continue
            </button>
        </form>
    </div>
</div>
