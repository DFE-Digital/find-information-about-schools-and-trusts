@page
@model DfE.FindInformationAcademiesTrusts.Pages.WatchList.Trusts

@{
    Layout = "_WatchListLayout";
    ViewData["Title"] = "Watchlist - Trusts";
    ViewData["ActiveWatchListTab"] = "Trusts";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <table class="govuk-table" data-module="moj-sortable-table">
            <caption class="govuk-table__caption govuk-visually-hidden">
                My watched trusts
            </caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header govuk-!-width-one-quarter" aria-sort="none">
                        Trust
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Date added to MSI
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Assigned to
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Supporting organisation
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Milestone
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="none">
                        Status
                    </th>
                </tr>
            </thead>

            <tbody class="govuk-table__body">
                @foreach (var item in Model.Items)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            @item.Name
                        </td>
                        <td class="govuk-table__cell">
                            @item.DateAddedToMsi
                        </td>
                        <td class="govuk-table__cell">
                            @item.AssignedTo
                        </td>
                        <td class="govuk-table__cell">
                            @item.SupportingOrganisation
                        </td>
                        <td class="govuk-table__cell">
                            @item.Milestone
                        </td>
                        <td class="govuk-table__cell">
                            <strong class="govuk-tag govuk-tag--@item.StatusTagColour">
                                @item.Status
                            </strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
